# Copy to .env and adjust. .env is ignored by git.
POSTGRES_USER=messenger
POSTGRES_PASSWORD=change-me
POSTGRES_DB=messenger

# For running the server outside Docker (docker compose builds DATABASE_URL from the values above).
DATABASE_URL=postgresql://messenger:change-me@localhost:5432/messenger
MESSENGER_PORT=9000
# Origin of the front-end that may call the API
CORS_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=168

# Address of the API as seen from the browser (used when building the front-end)
REACT_APP_API_URL=http://localhost:9000
